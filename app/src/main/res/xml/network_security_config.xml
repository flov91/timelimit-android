<!--
  Only relevant for builds compiled with -PuserCaTrust=true (see HttpClient.kt /
  SslConfig.kt). In that mode, HttpClient falls back to the platform's default TLS
  trust manager instead of pinning to the official server certificates, so this file
  lets that default trust manager also honor CA certificates the device owner has
  installed manually (e.g. a private CA used for a self-hosted TimeLimit server).
  This has no effect on regular builds, which keep using certificate pinning.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
